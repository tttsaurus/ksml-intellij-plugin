<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.tttsaurus.ksml</id>
    <name>Kirino Shader Meta Language</name>
    <vendor>tttsaurus</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.KsmlBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.tttsaurus.ksml.tool_window.KsmlToolWindowFactory" id="MyToolWindow"/>
        <postStartupActivity implementation="com.tttsaurus.ksml.startup.KsmlStartupActivity"/>

        <fileType
                name="KSML"
                language="KSML"
                extensions="ksml"
                implementationClass="com.tttsaurus.ksml.language.KsmlFileTypeDef"/>

        <lang.parserDefinition
                language="KSML"
                implementationClass="com.tttsaurus.ksml.language.parser.KsmlParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="KSML"
                implementationClass="com.tttsaurus.ksml.language.highlight.KsmlSyntaxHighlighterFactory"/>

<!--        <annotator -->
<!--                language="KSML" -->
<!--                implementationClass="com.tttsaurus.ksml.annotator.KsmlTestAnnotator"/>-->

        <editorFactoryListener implementation="com.tttsaurus.ksml.language.editor.GlslEditorListener"/>

        <languageInjector implementation="com.tttsaurus.ksml.language.embed.inject.GlslInKsmlInjector"/>
        <languageInjector implementation="com.tttsaurus.ksml.language.embed.inject.KsmlInGlslInjector"/>

        <annotator
                language="KsmlInGlsl"
                implementationClass="com.tttsaurus.ksml.language.embed.annotator.KiGImportAnnotator"/>

        <lang.parserDefinition
                language="KsmlInGlsl"
                implementationClass="com.tttsaurus.ksml.language.embed.parser.KiGParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="KsmlInGlsl"
                implementationClass="com.tttsaurus.ksml.language.embed.highlight.KiGSyntaxHighlighterFactory"/>

    </extensions>
</idea-plugin>
