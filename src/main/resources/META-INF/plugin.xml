<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.tttsaurus.ksml</id>
    <name>Kirino Shader Meta Language</name>
    <vendor>tttsaurus</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>OpenGL-Plugin</depends>

    <resource-bundle>messages.KsmlBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                factoryClass="com.tttsaurus.ksml.tool_window.KsmlToolWindowFactory"
                id="MyToolWindow"/>

        <postStartupActivity
                implementation="com.tttsaurus.ksml.startup.KsmlStartupActivity"/>

        <fileType
                name="KSML"
                language="KSML"
                extensions="ksml"
                implementationClass="com.tttsaurus.ksml.language.KsmlFileTypeDef"/>

        <fileType
                name="KsmlInGlsl"
                language="KsmlInGlsl"
                extensions="ksmlinglsl"
                implementationClass="com.tttsaurus.ksml.language.embedded.KiGFileTypeDef"/>

        <lang.parserDefinition
                language="KSML"
                implementationClass="com.tttsaurus.ksml.language.parser.KsmlParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="KSML"
                implementationClass="com.tttsaurus.ksml.language.analysis.highlight.KsmlSyntaxHighlighterFactory"/>

        <fileBasedIndex
                implementation="com.tttsaurus.ksml.language.index.KsmlModuleIndex"/>

        <fileBasedIndex
                implementation="com.tttsaurus.ksml.language.index.modulecall.ModuleFunctionCallIndex"/>

        <annotator
                language="KSML"
                implementationClass="com.tttsaurus.ksml.language.analysis.annotator.KsmlMetaDirectiveAnnotator"/>

        <editorFactoryListener
                implementation="com.tttsaurus.ksml.language.editor.GlslEditorListener"/>

        <languageInjector
                implementation="com.tttsaurus.ksml.language.inject.GlslInKsmlInjector"/>

        <languageInjector
                implementation="com.tttsaurus.ksml.language.inject.KsmlInGlslInjector"/>

        <psi.referenceContributor
                language="Glsl"
                implementation="com.tttsaurus.ksml.language.navigation.reference.KiGReferenceContributor"/>

        <annotator
                language="Glsl"
                implementationClass="com.tttsaurus.ksml.language.embedded.annotator.GlslModuleUsageAnnotator"/>

        <annotator
                language="Glsl"
                implementationClass="com.tttsaurus.ksml.language.embedded.annotator.GlslModuleFuncCallAnnotator"/>

        <annotator
                language="KsmlInGlsl"
                implementationClass="com.tttsaurus.ksml.language.embedded.annotator.KiGImportAnnotator"/>

        <lang.parserDefinition
                language="KsmlInGlsl"
                implementationClass="com.tttsaurus.ksml.language.embedded.parser.KiGParserDefinition"/>

        <stubIndex implementation="com.tttsaurus.ksml.language.index.KsmlFunctionIndex"/>

        <stubElementTypeHolder class="com.tttsaurus.ksml.language.stub.KsmlStubElementTypes"/>

        <completion.contributor
                language="Glsl"
                implementationClass="com.tttsaurus.ksml.language.navigation.completion.GlslCompletionContributor"/>

        <completion.contributor
                language="KSML"
                implementationClass="com.tttsaurus.ksml.language.navigation.completion.KsmlCompletionContributor"/>

        <lang.commenter
                language="KSML"
                implementationClass="com.tttsaurus.ksml.language.editor.KsmlCommenter"/>

        <lang.foldingBuilder
                language="KSML"
                implementationClass="com.tttsaurus.ksml.language.editor.KsmlFoldingBuilder"/>

        <typedHandler implementation="com.tttsaurus.ksml.language.editor.KsmlTypedHandlerDelegate"/>

        <enterHandlerDelegate implementation="com.tttsaurus.ksml.language.editor.KsmlEnterHandlerDelegate"/>

        <lang.findUsagesProvider
                language="KSML"
                implementationClass="com.tttsaurus.ksml.language.navigation.usage.provider.KsmlCodeDeclFindUsagesProvider"/>

        <codeInsight.daemonBoundCodeVisionProvider
                implementation="com.tttsaurus.ksml.language.navigation.usage.provider.KsmlCodeDeclVisionProvider"/>

        <config.codeVisionGroupSettingProvider
                implementation="com.tttsaurus.ksml.language.navigation.usage.provider.KsmlCodeDeclVisionGroupSettingProvider"/>

        <referencesSearch implementation="com.tttsaurus.ksml.language.navigation.KsmlCodeDeclReferenceSearcher"/>

    </extensions>
</idea-plugin>
